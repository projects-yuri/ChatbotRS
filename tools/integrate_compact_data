"""Integra apenas os indicadores selecionados do CSV oficial na base Markdown.

Uso: python tools/integrate_compact_data.py caminho/imers_pre_2022_2025.csv
Não requer pandas, banco vetorial ou a planilha completa no deploy.
"""
import argparse
import csv
import re
from decimal import Decimal, ROUND_HALF_UP
from pathlib import Path

MARKER = '## Dados municipais compactos — IMERS e PRE'


def value(row, field):
    text = row[field].strip()
    return None if text in ('', 'NA') else Decimal(text.replace(',', '.'))


def display(number, places=2, signed=False):
    if number is None:
        return 'não disponível'
    rounded = number.quantize(Decimal(10) ** -places, rounding=ROUND_HALF_UP)
    return format(rounded, ('+' if signed else '') + f'.{places}f').replace('.', ',')


def integrate(csv_path, base_path):
    with csv_path.open(encoding='utf-8-sig', newline='') as file:
        rows = list(csv.DictReader(file, delimiter=';'))
    selected = {}
    for row in rows:
        if row['ANO'] not in ('2024', '2025'):
            continue
        key = (row['CO_MUN7'], row['ANO'])
        if key in selected:
            raise ValueError(f'Registro duplicado: {key}')
        selected[key] = row
    codes = {code for code, year in selected if year == '2025'}
    if len(codes) != 497 or {(code, year) for code in codes for year in ('2024', '2025')} != set(selected):
        raise ValueError('São esperados 497 municípios nos dois anos selecionados.')
    base = base_path.read_text(encoding='utf-8')
    base = base.split(MARKER)[0].rstrip() + '\n'
    blocks = [base, '\n' + MARKER + '\n\n',
        'Fonte [D1]: DEE/SPGG, IMERSVis, arquivo `imers_pre_2022_2025.csv` e dicionário oficial, '
        'disponíveis em https://imersvis.dee.rs.gov.br/ . Recorte do arquivo usado no projeto em 24/10/2026. '
        'A coluna ANO representa a avaliação SAERS; os resultados de 2025 foram publicados em 2026.\n\n'
        'Cada seção municipal informa IMERS em 2024 e 2025 (escala 0–100), variação em pontos do índice '
        '(2025 menos 2024, calculada antes do arredondamento), componentes IQA/IQI/IQF (índices) e '
        'IA (taxa de aprovação em %) de 2025. PRE 2025 corresponde a PRE_PERCENTUAL: participação já '
        'expressa em % da parcela educacional, sem conversão por 100. Exemplo: 0,050000% permanece '
        '0,050000%; não equivale a 5%. Não é valor em reais nem IPM total.\n\n'
        'Os índices são da rede municipal. Valores de índices divulgados podem refletir tratamento '
        'metodológico quando não houve prova; os avisos locais preservam essa distinção. '
        'Índices e IA foram arredondados para duas casas; PRE para seis. Ausências são indicadas por '
        '“não disponível”. O recorte omite as demais colunas e os anos municipais anteriores para reduzir o tamanho.\n']
    for code in sorted(codes, key=lambda c: selected[c, '2025']['NOME_MUN']):
        row, previous = selected[code, '2025'], selected[code, '2024']
        current, old = value(row, 'IMERS'), value(previous, 'IMERS')
        delta = None if current is None or old is None else current - old
        blocks.append(f"\n## Município: {row['NOME_MUN']} — IBGE {code}\n\n"
                      f'IMERS: 2024 = {display(old)}; 2025 = {display(current)}. '
                      f'Variação 2025−2024: {display(delta, signed=True)} pontos.\n'
                      f"Componentes 2025: IQA = {display(value(row, 'IQA'))}; "
                      f"IQI = {display(value(row, 'IQI'))}; IQF = {display(value(row, 'IQF'))}; "
                      f"IA (aprovação) = {display(value(row, 'IA'))}%.\n"
                      f"PRE 2025 (IMERSVis, participação no rateio educacional): {display(value(row, 'PRE_PERCENTUAL'), 6)}%.\n")
        alerts = [f"{label}: {row[field].strip()}" for field, label in
                  [('Ocorreu_IQA_Port', 'IQA Português'), ('Ocorreu_IQA_Mat', 'IQA Matemática'),
                   ('Ocorreu_IQI', 'IQI'), ('Ocorreu_IQF', 'IQF')]
                  if row[field].strip() != 'Sim']
        if alerts:
            blocks.append('Aplicação da prova em 2025 — ' + '; '.join(alerts) + '.\n')
        blocks.append('Fonte: [D1], IMERSVis.\n')
    base_path.write_text(''.join(blocks), encoding='utf-8')
    from organize_base import organize
    organize(base_path)
    print(f'{len(codes)} municípios; {base_path.stat().st_size} bytes')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('csv_path', type=Path)
    parser.add_argument('--base', type=Path, default=Path(__file__).resolve().parents[1] / 'raw/Base_Unificada_Educacao_RS.md')
    args = parser.parse_args()
    integrate(args.csv_path, args.base)
